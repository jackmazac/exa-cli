# Required for every API command. The CLI does not accept API keys as flags.
EXA_API_KEY=your_exa_api_key

# Optional integration attribution. Non-ASCII text is percent-encoded.
EXA_SOURCE=my-integration

# Optional. Defaults to https://api.exa.ai.
# HTTP is rejected unless the host is localhost, 127.0.0.1, or ::1.
EXA_API_BASE_URL=https://api.exa.ai
